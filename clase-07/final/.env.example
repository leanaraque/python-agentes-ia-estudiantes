WEATHER_LONGITUDE=
GROQ_API_KEY=
GROQ_MODEL=
LLM_PROVIDER=
OLLAMA_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
